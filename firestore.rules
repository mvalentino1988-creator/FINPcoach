rules_version = '2';

// Regole Firestore FINPcoach.
// I dati sincronizzati (anagrafica atleti, note mediche, tempi, piani)
// vivono in users/{userId}: accessibili SOLO all'utente autenticato
// proprietario del documento. Nessun altro accesso, nemmeno in lettura.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Qualsiasi altra collezione e' negata.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
