# Firebase Configuration per Cloud Sync
# Ottieni questi valori da https://console.firebase.google.com/
# Crea un progetto, abilita Firestore Database e Authentication (Email/Password)

VITE_FIREBASE_API_KEY=tu_api_key_qui
VITE_FIREBASE_AUTH_DOMAIN=tu_progetto.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=tu_project_id
VITE_FIREBASE_STORAGE_BUCKET=tu_proyecto.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=tu_sender_id
VITE_FIREBASE_APP_ID=tu_app_id
